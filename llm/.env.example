LLM_PROVIDER=mock
LLM_GRPC_HOST=0.0.0.0
LLM_GRPC_PORT=50052
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_GPU_MEMORY_UTIL=0.88
# Cap context when the model's native length does not fit leftover VRAM.
# Qwen3-4B at 40960 needs ~5.6 GiB of KV cache; 16384 fits a 16GB GPU at 0.75 utilization.
VLLM_MAX_MODEL_LEN=16384

# Model Cache Paths
HF_HOME=../model_cache/huggingface
